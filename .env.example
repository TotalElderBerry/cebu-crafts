# ---------------------------------------------------------------------------
# Neon Postgres
# Get this from https://console.neon.tech -> your project -> Connection string
# Use the POOLED connection string (host contains "-pooler") for the app.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Session encryption for nuxt-auth-utils. MUST be at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
NUXT_SESSION_PASSWORD="replace-me-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Public API base.
#   Web build   -> leave empty, the app calls its own Nitro server on /api
#   Mobile build-> set to the deployed origin, e.g. https://likhacebu.vercel.app
# ---------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=""

# Optional: Cloudinary unsigned upload (image hosting)
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---------------------------------------------------------------------------
# PayMongo — https://dashboard.paymongo.com/developers
# Leave PAYMONGO_SECRET_KEY blank to fall back to the simulated card flow.
# Use the TEST key (sk_test_...) until you are ready to take real money.
# ---------------------------------------------------------------------------
PAYMONGO_SECRET_KEY=""
# From Developers -> Webhooks after you create one pointing at
#   https://<your-origin>/api/webhooks/paymongo
# subscribed to: checkout_session.payment.paid, payment.failed
PAYMONGO_WEBHOOK_SECRET=""
# Which rails to offer, comma separated: gcash, paymaya, grab_pay, card
PAYMONGO_RAILS="gcash,paymaya,grab_pay,card"

# Public origin PayMongo returns the buyer to. Required for the mobile build,
# whose requests come from capacitor://localhost. Leave blank in local dev.
NUXT_PUBLIC_APP_ORIGIN=""
