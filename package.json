{
  "name": "cebu-crafts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Likha Cebu - a marketplace connecting Cebu craft makers directly to buyers",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/database/seed.ts",
    "mobile:build": "cross-env NUXT_MOBILE=true nuxt generate && cap sync",
    "mobile:android": "cross-env NUXT_MOBILE=true nuxt generate && cap sync android && cap open android",
    "mobile:ios": "cross-env NUXT_MOBILE=true nuxt generate && cap sync ios && cap open ios",
    "db:validate": "tsx scripts/validate-seed.ts",
    "test:signature": "tsx scripts/verify-paymongo-signature.mts",
    "photos:fetch": "tsx scripts/fetch-listing-photos.mts",
    "photos:sheet": "tsx scripts/contact-sheet.mts",
    "geo:verify": "tsx scripts/verify-cebu-geo.mts"
  },
  "dependencies": {
    "@adonisjs/hash": "^10.1.1",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@lucide/vue": "^1.47.0",
    "@neondatabase/serverless": "^1.0.0",
    "@nuxt/fonts": "^0.14.0",
    "@vueuse/core": "^13.0.0",
    "@vueuse/nuxt": "^13.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "leaflet": "1.9.4",
    "lucide-vue-next": "^0.544.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.2.0"
  }
}
